{
  "expo": {
    "name": "PackInspect AI",
    "slug": "packinspect-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.packinspect.ai",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.packinspect.ai",
      "infoPlist": {
        "NSCameraUsageDescription": "PackInspect uses your camera to scan package declarations.",
        "NSPhotoLibraryUsageDescription": "PackInspect uses selected package images for analysis."
      }
    },
    "plugins": [
      "expo-image-picker",
      "expo-asset"
    ]
  }
}
