# ─────────────────────────────────────────────────────────────────────────────
# PackSure AI — Backend Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local: mongodb://localhost:27017
# Docker: mongodb://mongodb:27017
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=packsure_ai

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI Provider ───────────────────────────────────────────────────────────────
# "gemini" uses Gemini for declaration extraction and compliance evaluation.
# "mock" is only for local demos.
AI_PROVIDER=gemini
GEMINI_API_KEY=

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
REPORT_DIR=reports
MAX_UPLOAD_SIZE_MB=10

# ── Cloudinary ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=PackSure AI API
APP_VERSION=1.0.0
